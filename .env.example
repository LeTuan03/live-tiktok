# LiveFlow AI Studio — Environment Configuration
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# --- Application ---
# LIVEFLOW_DEBUG=false
# LIVEFLOW_LOG_LEVEL=INFO

# --- AI / LLM ---
# LIVEFLOW_LLM_PROVIDER=gemini
# LIVEFLOW_GEMINI_API_KEY=AIzaSy...
# LIVEFLOW_GEMINI_MODEL=gemini-1.5-flash
# Hoặc dùng OpenAI:
# LIVEFLOW_LLM_PROVIDER=openai
# LIVEFLOW_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- TTS ---
# LIVEFLOW_TTS_PROVIDER=edge_tts
# LIVEFLOW_TTS_DEFAULT_VOICE=vi-VN-HoaiMyNeural

# --- OBS ---
# LIVEFLOW_OBS_HOST=localhost
# LIVEFLOW_OBS_PORT=4455

# --- TikTok ---
# LIVEFLOW_TIKTOK_INTEGRATION_MODE=manual
