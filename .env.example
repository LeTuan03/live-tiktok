# LiveFlow AI Studio — cấu hình môi trường (TÙY CHỌN)
# Sao chép thành .env nếu muốn cấu hình sẵn; mọi thiết lập dưới đây đều có thể nhập trong
# giao diện Cài đặt của ứng dụng (khuyên dùng — API key được lưu an toàn trong Windows Credential Manager).
# KHÔNG commit file .env lên git.

# --- Ứng dụng ---
# LIVEFLOW_DEBUG=false
# LIVEFLOW_LOG_LEVEL=INFO
# LIVEFLOW_DATA_DIR=D:\LiveFlowData        # mặc định: %LOCALAPPDATA%\LiveFlowAIStudio

# --- AI / LLM ---
# LIVEFLOW_LLM_PROVIDER=gemini             # gemini | openai
# LIVEFLOW_GEMINI_API_KEY=                 # lấy tại https://aistudio.google.com/app/apikey
# LIVEFLOW_GEMINI_MODEL=gemini-3.5-flash
# LIVEFLOW_OPENAI_API_KEY=
# LIVEFLOW_OPENAI_BASE_URL=                # VD Ollama: http://localhost:11434/v1
# LIVEFLOW_OPENAI_MODEL=gpt-4o-mini

# --- TTS ---
# LIVEFLOW_TTS_DEFAULT_VOICE=vi-VN-HoaiMyNeural

# --- OBS WebSocket ---
# LIVEFLOW_OBS_HOST=localhost
# LIVEFLOW_OBS_PORT=4455
# LIVEFLOW_OBS_SCENE_NAME=LiveFlow AI
# LIVEFLOW_OBS_VIDEO_SOURCE=LiveFlow Video
# LIVEFLOW_OBS_AUDIO_SOURCE=LiveFlow Audio

# --- Nền tảng ---
# LIVEFLOW_DEFAULT_PLATFORM=tiktok         # tiktok | shopee

# --- FFmpeg (nếu không nằm trong PATH / tools\ffmpeg) ---
# LIVEFLOW_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# LIVEFLOW_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
