# LiveFlow AI Studio — cấu hình môi trường (TÙY CHỌN)
# Sao chép thành .env nếu muốn cấu hình sẵn; mọi thiết lập dưới đây đều có thể nhập trong
# giao diện Cài đặt của ứng dụng (khuyên dùng — API key được lưu an toàn trong Windows Credential Manager).
# KHÔNG commit file .env lên git.

# --- Ứng dụng ---
# LIVEFLOW_DEBUG=false
# LIVEFLOW_LOG_LEVEL=INFO
# LIVEFLOW_DATA_DIR=D:\LiveFlowData        # mặc định: %LOCALAPPDATA%\LiveFlowAIStudio

# --- AI / LLM ---
# LIVEFLOW_LLM_PROVIDER=gemini             # gemini | openai
# LIVEFLOW_GEMINI_API_KEY=                 # lấy tại https://aistudio.google.com/app/apikey
# LIVEFLOW_GEMINI_MODEL=gemini-3.5-flash

# --- Video AI người thật (Google Gemini Omni / Veo) ---
# LIVEFLOW_VEO_MODEL=gemini-omni-1.1-flash
# LIVEFLOW_VEO_RESOLUTION=720p              # 360p | 720p | 1080p
# LIVEFLOW_VEO_USE_NATIVE_AUDIO=true        # true: người mẫu tự nói tiếng Việt (khớp khẩu hình); false: dùng Edge-TTS
# LIVEFLOW_VEO_ALLOW_LOCAL_FALLBACK=false   # true: khi lỗi cloud thì chuyển sang cử động 2D nhẹ; false: báo lỗi chi tiết
# LIVEFLOW_OPENAI_API_KEY=
# LIVEFLOW_OPENAI_BASE_URL=                # VD Ollama: http://localhost:11434/v1
# LIVEFLOW_OPENAI_MODEL=gpt-4o-mini

# --- Google Flow (flow.google.com) ---
# "flow" = dùng tín dụng Flow của gói Google AI qua trình duyệt nhúng trong app
#          (KHÔNG cần API key, KHÔNG cần bật Billing) — khuyên dùng.
# "api"  = gọi thẳng Gemini/Veo API (phải bật Billing trong Google Cloud).
# LIVEFLOW_VIDEO_SOURCE=flow
# LIVEFLOW_FLOW_MODEL=veo-3.1-fast        # veo-3.1-fast (20 tín dụng) | veo-3.1-quality (100) | veo-3.1-lite (10)
# LIVEFLOW_FLOW_RESOLUTION=720p           # 720p | 1080p
# LIVEFLOW_FLOW_DURATION_SECONDS=8        # 4 | 6 | 8
# LIVEFLOW_FLOW_CREDITS_TOTAL=1050        # số dư tín dụng ban đầu, app tự trừ dần
# LIVEFLOW_FLOW_CREDIT_COST=0             # >0: tự nhập giá/lần tạo khi Google đổi giá
# LIVEFLOW_FLOW_IMAGE_CREDIT_COST=0
# LIVEFLOW_FLOW_AUTO_GENERATE=true        # true: app tự bấm Tạo trong Flow
# LIVEFLOW_FLOW_AUTO_IMPORT=true          # true: tự nhận file tải về rồi chuẩn hoá & nạp
# LIVEFLOW_FLOW_WAIT_TIMEOUT_SECONDS=420  # chờ tối đa bao lâu cho 1 clip render xong
# LIVEFLOW_FLOW_DOWNLOADS_DIR=

# --- TTS ---
# LIVEFLOW_TTS_DEFAULT_VOICE=vi-VN-HoaiMyNeural

# --- OBS WebSocket ---
# LIVEFLOW_OBS_HOST=localhost
# LIVEFLOW_OBS_PORT=4455
# LIVEFLOW_OBS_SCENE_NAME=LiveFlow AI
# LIVEFLOW_OBS_VIDEO_SOURCE=LiveFlow Video
# LIVEFLOW_OBS_AUDIO_SOURCE=LiveFlow Audio

# --- Nền tảng ---
# LIVEFLOW_DEFAULT_PLATFORM=tiktok         # tiktok | shopee

# --- FFmpeg (nếu không nằm trong PATH / tools\ffmpeg) ---
# LIVEFLOW_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# LIVEFLOW_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
