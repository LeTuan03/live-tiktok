# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# The agent_name the worker registers under and that dispatches target. They
# MUST match for LiveKit to route a dispatch to this worker. Override locally
# (e.g. AGENT_NAME=plug-agent-local) when a deployed worker is also registered
# on the same LiveKit project, otherwise LiveKit load-balances dispatches across
# both and some land on the remote worker instead of your local one.
AGENT_NAME=plug-agent

# Advertiser portal default org. The portal runs without an external auth
# provider; requests resolve to this org unless an `X-Org-Id` header overrides
# it. Defaults to the org seeded by the bundled example catalog
# (seed/catalog.json.example) so a fresh clone shows real portal data. Override
# this when you seed a custom catalog whose advertiser uses a different org_id.
DEFAULT_ORG_ID=org_demo_shop

# LLM / STT
GROQ_API_KEY=
# Chat model for the pitch LLM. Use a non-reasoning model listed by
# https://api.groq.com/openai/v1/models for your key.
GROQ_LLM_MODEL=qwen/qwen3.8-27b

# TTS (ElevenLabs)
# Leave blank to use the keyless TTS fallback. EDGE_TTS_VOICE is its default
# voice for the feed: an Edge voice name, or google-<lang> such as google-vi.
# Studio models pick their own voice.
ELEVEN_API_KEY=
EDGE_TTS_VOICE=en-US-AriaNeural

# Avatar (LemonSlice). Leave blank and the agent publishes the persona image
# as a gently animated still video instead (no lip sync).
LEMONSLICE_API_KEY=
# Idle seconds before a LemonSlice avatar session tears down. -1 keeps the
# always-on channel agent's avatar warm across stretches of empty rooms.
LEMONSLICE_IDLE_TIMEOUT=-1

# Live studio runtime data (uploads, avatar assets, model weights). Relative to
# server/. Git-ignored.
DATA_DIR=data

# Promo videos made with Google Flow (see "Promo videos with Google Flow" in
# README.md). Script LLM on Groq, the default Flow video model as named in
# Flow's model menu ("Veo 3.1 - Lite", "Omni 1.2 Flash", "Veo 3.1 - Fast",
# "Veo 3.1 - Quality"), the per-shot timeout, and the Whisper model that checks
# each clip says its scripted line.
PROMO_LLM_MODEL=openai/gpt-oss-120b
PROMO_FLOW_MODEL=Veo 3.1 - Lite
PROMO_SHOT_TIMEOUT_S=600
PROMO_TRANSCRIBE_MODEL=whisper-large-v3

# CPU load (0 to 1) above which the worker refuses new jobs. Only applies when
# ENVIRONMENT is not "development"; in development it always accepts.
AGENT_LOAD_THRESHOLD=0.7

# Database (Postgres). Use the POOLED connection string.
# On Neon the host ends in `-pooler.<region>.aws.neon.tech`.
# Format: postgresql://<user>:<pass>@<branch>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Deployment environment. Leave "development" locally; set to "production"
# (or any non-development value) in deployed envs so missing LiveKit secrets
# fail fast instead of falling back to well-known dev credentials.
ENVIRONMENT=development

# S3 / S3-compatible asset hosting (Tigris in prod, MinIO for local dev).
# `BUCKET_NAME` + `AWS_*` are the access creds; `S3_PUBLIC_URL` is the CDN-
# friendly base used for public read URLs returned to clients (set this to
# your CDN once it's in front of the bucket, no code change needed).
# `S3_REGION` defaults to `auto` which works for Tigris/MinIO; set to a real
# AWS region (e.g. `us-east-1`) when pointing at AWS S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
BUCKET_NAME=
S3_REGION=auto
S3_PUBLIC_URL=

# Production Tigris (SoShop bucket). The S3 endpoint
# (`fly.storage.tigris.dev`) always requires SigV4 auth, even for
# objects with `public-read` ACL. Public reads happen through Tigris's
# dedicated public-content domain (`<bucket>.t3.tigrisfiles.io`), which
# is what `S3_PUBLIC_URL` should point at. The bucket must also be
# flagged public-read at the bucket level (one-time):
#     flyctl storage update soshop --public
# or, equivalently, via boto3:
#     s3.put_bucket_acl(Bucket="soshop", ACL="public-read")
#   AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
#   BUCKET_NAME=soshop
#   S3_PUBLIC_URL=https://soshop.t3.tigrisfiles.io

# Local dev with MinIO (see server/README.md for the docker run command):
#   AWS_ACCESS_KEY_ID=minioadmin
#   AWS_SECRET_ACCESS_KEY=minioadmin
#   AWS_ENDPOINT_URL_S3=http://localhost:9000
#   BUCKET_NAME=soshop-dev
#   S3_PUBLIC_URL=http://localhost:9000/soshop-dev

# Where studio uploads and promo video files live (soshop_server.storage).
# `local`: under DATA_DIR, served by the API at /media. `s3`: in BUCKET_NAME,
# read by browsers from S3_PUBLIC_URL (needs the AWS_* vars above). Use `s3`
# for any deploy with more than one machine or an ephemeral disk. Move existing
# files with `uv run python scripts/migrate_media.py --upload`.
MEDIA_STORAGE=local

# Comma-separated list of origins permitted by CORS. Set to `*` to allow any
# origin (disables credentialed CORS per spec). Defaults cover local Next.js
# dev on :3000.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public-test gate (mirror to Vercel as SITE_PASSWORD on the web project,
# and to web/.env.local for local dev). The web /api/agents/session proxy
# forwards this as Bearer to /agents/session here.
SITE_PASSWORD=
# Wind-down timeout for an on-demand agent session (LemonSlice cost cap).
AGENT_SESSION_DURATION_MINUTES=10

# Always-on channels. CHANNEL_COUNT is the number of channels reconciled on
# startup (and via POST /admin/channels/reconcile). FEED_SWAP_MODE selects the
# persona-swap strategy: `in_place` (default; mutates the running agent) or the
# legacy redispatch fallbacks `single_room` / `ping_pong`.
# CHANNEL_MIN_SLOT_SECONDS floors how long a channel stays on one ad. Leave 0
# on a paid LLM tier. On Groq's free tier (7000 input tokens per minute, one
# pitch request is about 1700) set it to 20 so failed pitches cannot spiral.
CHANNEL_MIN_SLOT_SECONDS=0
CHANNEL_COUNT=1
FEED_SWAP_MODE=in_place

# OpenTelemetry tracing (optional). OTEL_ENABLED installs the FastAPI
# auto-instrumentor; set OTEL_EXPORTER_OTLP_ENDPOINT to batch-export spans.
# OTEL_SERVICE_NAME is the service name reported on exported spans.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=soshop-server
