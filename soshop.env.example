# SoShop settings for the Docker bundle (docker-compose.yml).
#
# Copy this file to soshop.env (soshop-start.cmd does it for you on first run)
# and fill in your keys. soshop.env is git-ignored, never commit it.
# After editing, run soshop-start.cmd again (or `docker compose up -d`) to apply.
#
# Database, LiveKit and storage are wired up by docker-compose.yml, so they are
# not set here.

# --- Required ------------------------------------------------------------------
# Groq key for the host's brain, speech-to-text and video scripts.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# --- Voice and language ----------------------------------------------------------
# Default voice when there is no ElevenLabs key. google-vi is the keyless
# Vietnamese voice. For English use an Edge voice such as en-US-AriaNeural.
EDGE_TTS_VOICE=google-vi

# Chat model for the live host. Must be a non-reasoning model your Groq key can use.
GROQ_LLM_MODEL=qwen/qwen3.8-27b
# Model that writes promo video scripts.
PROMO_LLM_MODEL=openai/gpt-oss-120b

# --- Optional paid providers --------------------------------------------------------
# ElevenLabs voices. Leave blank to use the free voice above.
ELEVEN_API_KEY=
# LemonSlice realtime avatar. Leave blank to use the built-in local lip-sync avatar.
LEMONSLICE_API_KEY=

# --- Tuning ----------------------------------------------------------------------
# Minimum seconds a channel stays on one product. 20 keeps Groq's free tier
# (7000 input tokens per minute) from running out. Set 0 on a paid tier.
CHANNEL_MIN_SLOT_SECONDS=20
# Number of always-on channels in the feed.
CHANNEL_COUNT=1

# Google Flow video model, as named in Flow's model menu.
PROMO_FLOW_MODEL=Veo 3.1 - Lite
