# SoShop server API (env-driven; do not hard-code per environment)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Shared bearer token the /api/agents/session proxy forwards to the
# FastAPI /agents/session route. Must match SITE_PASSWORD on the server.
SITE_PASSWORD=

# Optional default persona + script for the 1:1 "talk to the host" companion
# route (/persona). The app falls back to a built-in "default" id when unset;
# set these to a seeded persona/script id to change the default host.
NEXT_PUBLIC_PERSONA_DEFAULT_ID=
NEXT_PUBLIC_PERSONA_DEFAULT_SCRIPT_ID=
